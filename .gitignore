# Entornos virtuales
.venv/
venv/
env/

# Python / Bytecode
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Datos crudos y procesados (los datos no se suben a git)
/data/*
*.csv
*.parquet
*.json
*.xlsx
# Excepción: metadata.json (con el hash del ZIP) SÍ se versiona
!/data/raw/
/data/raw/*
!/data/raw/metadata.json
# Excepción: el resumen de drift (JSON pequeño) SÍ se versiona
!/reports/*.json

# Modelos entrenados y artefactos pesados
models/*.pkl
models/*.joblib
models/*.onnx
models/*.pt
models/*.h5

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Variables de entorno y secretos
.env
*.local
.prefect_cache/
